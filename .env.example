# ---------------------------------------------------------------------------
# TaskFlow backend — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL (used directly by Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# When running via `docker compose up`, the api/worker containers ignore this
# value and instead build their own DATABASE_URL pointing at the `postgres`
# service (see docker-compose.yml). This value is used for local (non-Docker)
# `npm run dev` against the Postgres container's published port.
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public

# PostgreSQL container credentials (read by docker-compose.yml)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# Redis (used by BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Generate strong random secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# bcrypt
BCRYPT_COST_FACTOR=12

# Rate limiting (auth endpoints)
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# CORS
CORS_ORIGIN=*
